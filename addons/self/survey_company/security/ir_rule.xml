<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Desactivar reglas nativas survey.survey -->
        <record id="survey.survey_survey_rule_survey_manager" model="ir.rule">
            <field name="active" eval="False"/>
        </record>
        <record id="survey.survey_survey_rule_survey_user_read" model="ir.rule">
            <field name="active" eval="False"/>
        </record>
        <record id="survey.survey_survey_rule_survey_user_cwu" model="ir.rule">
            <field name="active" eval="False"/>
        </record>

        <!-- Desactivar reglas nativas survey.user_input -->
        <record id="survey.survey_user_input_rule_survey_manager" model="ir.rule">
            <field name="active" eval="False"/>
        </record>
        <record id="survey.survey_user_input_rule_survey_user_read" model="ir.rule">
            <field name="active" eval="False"/>
        </record>
        <record id="survey.survey_user_input_rule_survey_user_cw" model="ir.rule">
            <field name="active" eval="False"/>
        </record>

        <!-- Reglas de aislamiento por compañía -->
        <record id="rule_survey_by_company" model="ir.rule">
            <field name="name">Survey: aislar por compañía</field>
            <field name="model_id" ref="survey.model_survey_survey"/>
            <field name="active" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_survey_user_input_by_company" model="ir.rule">
            <field name="name">Survey Participación: aislar por compañía</field>
            <field name="model_id" ref="survey.model_survey_user_input"/>
            <field name="active" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_geo_zone_by_company" model="ir.rule">
            <field name="name">Geo Zone: aislar por compañía</field>
            <field name="model_id" ref="survey_geofencing.model_geo_zone"/>
            <field name="active" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
    </data>
</odoo>
