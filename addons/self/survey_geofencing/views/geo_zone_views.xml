<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_geo_zone_tree" model="ir.ui.view">
        <field name="name">geo.zone.tree</field>
        <field name="model">geo.zone</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_geo_zone_form" model="ir.ui.view">
        <field name="name">geo.zone.form</field>
        <field name="model">geo.zone</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                        <field name="color" widget="color_picker"/>
                    </group>
                    <!-- <group string="Datos GeoJSON">
                        <field name="geojson_data" widget="text"/>
                    </group> -->
                    <notebook>
                        <page string="Mapa">
                            <field name="map_view" widget="geo_zone_map" nolabel="1"/>
                        </page>
                        <page string="Datos GeoJSON">
                            <field name="geojson_data" widget="text"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_geo_zone" model="ir.actions.act_window">
        <field name="name">Zonas Geográficas</field>
        <field name="res_model">geo.zone</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_geo_zone_root"
              name="Geo Heart"
              sequence="100"/>
    
    <menuitem id="menu_geo_zone"
              name="Zonas Geográficas"
              parent="menu_geo_zone_root"
              action="action_geo_zone"
              sequence="10"/>
</odoo>
