<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Wizard Form -->
    <record id="view_import_kmz_wizard_form" model="ir.ui.view">
        <field name="name">import.kmz.wizard.form</field>
        <field name="model">import.kmz.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="name" placeholder="Ej: Zona Norte"/>
                    <field name="filename" invisible="1"/>
                    <field name="file" filename="filename"/>
                </group>
                <footer>
                    <button name="action_import" string="Importar" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_import_kmz_wizard" model="ir.actions.act_window">
        <field name="name">Importar KMZ/GeoJSON</field>
        <field name="res_model">import.kmz.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_import_kmz"
              name="Importar KMZ/GeoJSON"
              parent="menu_geo_zone_root"
              action="action_import_kmz_wizard"
              sequence="20"/>
</odoo>
