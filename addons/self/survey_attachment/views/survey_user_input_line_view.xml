<odoo>

    <record id="survey_attachment_inherit_survey_user_input_line_form"
            model="ir.ui.view">
        <field name="name">survey.user_input.line.form (survey_attachment)</field>
        <field name="model">survey.user_input.line</field>
        <field name="inherit_id" ref="survey.survey_user_input_line_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='answer_type']" position="after">
                 <field name="filename"/>
            </xpath>
            <field name="suggested_answer_id" position="after">
                <field name="answer_type" invisible="1"/>
                <field name="value_file_ids" attrs="{'invisible': [('answer_type', '!=', 'file')]}">
                    <tree create="0" edit="0">
                        <field name="id" invisible="1"/>
                        <field name="name"/>
                        <button string="Vista previa" type="object"
                            name="action_preview_attachment"
                            icon="fa-eye"/>
                    </tree>
                </field>
            </field>
        </field>
    </record>

</odoo>
